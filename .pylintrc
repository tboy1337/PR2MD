[MAIN]
# Use multiple processes to speed up Pylint
jobs = 0

# Pickle collected data for later comparisons
persistent = yes

# Allow loading of arbitrary C extensions
unsafe-load-any-extension = no

# Minimum Python version
py-version = 3.12

[MESSAGES CONTROL]
# Disable warnings that don't apply to this project:
# - too-few-public-methods: Utility classes like formatters don't need multiple public methods
# - too-many-instance-attributes: Data models naturally have many attributes
# - fixme: Allow TODO/FIXME comments during development
# - logging-fstring-interpolation: f-strings in logging are acceptable with proper error handling
disable=too-few-public-methods,
        too-many-instance-attributes,
        fixme,
        logging-fstring-interpolation

# Enable specific warnings
enable=useless-suppression

[REPORTS]
# Set the output format
output-format = text

# Display statistics on collected data
reports = yes

# Evaluate score (yes/no)
score = yes

[FORMAT]
# Maximum number of characters on a single line (match Black)
max-line-length = 88

# Maximum number of lines in a module
max-module-lines = 1000

# String used for indentation
indent-string = '    '

[BASIC]
# Good variable names
good-names = i,
             j,
             k,
             ex,
             Run,
             _,
             id,
             db,
             pk,
             df,
             ax,
             x,
             y,
             z

# Regular expression matching correct function names
function-rgx = [a-z_][a-z0-9_]{2,50}$

# Regular expression matching correct method names
method-rgx = [a-z_][a-z0-9_]{2,50}$

# Regular expression matching correct constant names
const-rgx = (([A-Z_][A-Z0-9_]*)|(__.*__))$

# Regular expression matching correct attribute names
attr-rgx = [a-z_][a-z0-9_]{2,50}$

# Regular expression matching correct argument names
argument-rgx = [a-z_][a-z0-9_]{2,50}$

# Regular expression matching correct variable names
variable-rgx = [a-z_][a-z0-9_]{2,50}$

# Regular expression matching correct class attribute names
class-attribute-rgx = ([A-Za-z_][A-Za-z0-9_]{2,50}|(__.*__))$

# Regular expression matching correct class names
class-rgx = [A-Z_][a-zA-Z0-9]+$

# Regular expression matching correct module names
module-rgx = (([a-z_][a-z0-9_]*)|([A-Z][a-zA-Z0-9]+))$

[DESIGN]
# Maximum number of arguments for function / method
max-args = 7

# Maximum number of attributes for a class
max-attributes = 20

# Maximum number of boolean expressions in an if statement
max-bool-expr = 5

# Maximum number of branch for function / method body (enforce <10 per user rules)
max-branches = 10

# Maximum number of locals for function / method body
max-locals = 15

# Maximum number of return / yield for function / method body
max-returns = 6

# Maximum number of statements in function / method body
max-statements = 50

# Minimum number of public methods for a class
min-public-methods = 1

# Maximum number of public methods for a class
max-public-methods = 25

# Maximum number of parents for a class
max-parents = 7

[IMPORTS]
# Allow wildcard imports from modules that define __all__
allow-wildcard-with-all = no

# Deprecated modules to check for
deprecated-modules = optparse,
                     imp

[CLASSES]
# List of method names used to declare (i.e. assign) instance attributes
defining-attr-methods = __init__,
                        __new__,
                        setUp,
                        __post_init__

# List of valid names for the first argument in a class method
valid-classmethod-first-arg = cls

# List of valid names for the first argument in a metaclass class method
valid-metaclass-classmethod-first-arg = mcs

[EXCEPTIONS]
# Exceptions that will emit a warning when being caught
overgeneral-exceptions = builtins.BaseException,
                        builtins.Exception

[SIMILARITIES]
# Minimum lines number of a similarity (higher for test fixtures)
min-similarity-lines = 20

# Ignore comments when computing similarities
ignore-comments = yes

# Ignore docstrings when computing similarities
ignore-docstrings = yes

# Ignore imports when computing similarities
ignore-imports = yes

# Ignore duplicate code in test files where fixtures often contain similar setup
ignore-signatures = yes

[SPELLING]
# Limits count of emitted suggestions for spelling mistakes
max-spelling-suggestions = 4

[VARIABLES]
# Tells whether we should check for unused import in __init__ files
init-import = no

# A regular expression matching the name of dummy variables
dummy-variables-rgx = _+$|(_[a-zA-Z0-9_]*[a-zA-Z0-9]+?$)|dummy|^ignored_|^unused_

# Argument names that match this expression will be ignored
ignored-argument-names = _.*|^ignored_|^unused_

[STRING]
# This flag controls whether inconsistent-quotes generates a warning when the
# character used as a quote delimiter is used inconsistently within a module
check-quote-consistency = yes

# This flag controls whether the implicit-str-concat should generate a warning
# on implicit string concatenation in sequences defined over several lines
check-str-concat-over-line-jumps = no
